# Supabase — copy to .env.local and fill in (Project Settings → API).
# Until these are set, the app runs on the in-memory demo store.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 2a preview only. Default false preserves the live demo.
# Apply 0005 through CI before enabling on a separate Railway preview service.
VITE_LIVE_AVAILABILITY=false
