# Supabase — copy to .env.local and fill in (Project Settings → API).
# Missing credentials show unavailable/empty states, never sample availability.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Real data is the default. Explicit false is for local demo development only.
# Apply 0005 through the approved CI rollout before switching production.
VITE_LIVE_AVAILABILITY=true
